# crop-prognosis Environment Configuration Example File
# Copy to .env and adjust configuration settings as needed.

APP_NAME=crop-prognosis-api
APP_VERSION=1.0.0
DEBUG=false

# Model Bundle Directory
BUNDLE_DIR=models
DEV_STUB_MODELS=false

# Upload Safety Constraints
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
STORE_UPLOADS=false
UPLOAD_STORE_DIR=data/interim/user_uploads

# Security & Operations
CORS_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=60
